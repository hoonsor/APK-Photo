{
  "api": 1,
  "status": "planned",
  "app": "照片整理箱",
  "package": "com.photobox.sorter",
  "version": "1.1.8",
  "description": "整理手機照片與影片：虛擬相簿、滑動整理標記保留／待刪、相似照片、分享與備份。完全離線。",
  "notes": "Agent API 尚未實作；所有動作皆為規劃中。實作前需先改用共用簽章（signature 權限），見 AGENTS.md 坑 15。",
  "actions": [
    {
      "name": "photo_list",
      "title": "查詢照片",
      "description": "依條件列出照片與影片（id、檔名、時間、資料夾、大小、整理狀態）",
      "risk": "read",
      "params": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "description": "以條件選取照片，與 ids 二擇一",
            "properties": {
              "query": {
                "type": "string",
                "description": "檔名、資料夾，或日期 2023 / 2023-07 / 2023-07-15"
              },
              "date_from": {
                "type": "string",
                "format": "date"
              },
              "date_to": {
                "type": "string",
                "format": "date"
              },
              "state": {
                "type": "string",
                "enum": [
                  "any",
                  "unsorted",
                  "kept",
                  "pending"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "any",
                  "photo",
                  "video"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "any",
                  "screenshot",
                  "line",
                  "large"
                ]
              },
              "folder": {
                "type": "string"
              },
              "album": {
                "type": "string"
              }
            }
          },
          "sort": {
            "type": "string",
            "enum": [
              "newest",
              "oldest",
              "largest"
            ],
            "default": "newest"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50
          }
        },
        "additionalProperties": false
      },
      "examples": [
        "列出昨天拍的照片",
        "找出 2023 年 7 月的影片",
        "有哪些從 LINE 存下來的照片"
      ],
      "status": "planned"
    },
    {
      "name": "photo_get",
      "title": "照片詳細資訊",
      "description": "取得單張的 EXIF、位置（需權限）、所在相簿與完整路徑",
      "risk": "read",
      "params": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      },
      "examples": [
        "這張照片是在哪裡拍的",
        "這張是什麼手機拍的"
      ],
      "status": "planned"
    },
    {
      "name": "photo_open",
      "title": "開啟照片",
      "description": "在 App 內開啟某張照片的檢視畫面（會回 NEEDS_UI）",
      "risk": "read",
      "params": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
